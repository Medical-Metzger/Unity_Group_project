  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The hollow central operning that carries blood. it is typically wider
    in veins. This helps facilitate low-pressure blood flow back to the heart. \n\nVeins
    generally have thin walls and a large lumen. "
  m_isRightToLeft: 0
