  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The hollow central operning that carries blood. it is typically smaller
    in arteries. A narrow lumen is designed to withstand high pressure blood flow
    from the heart to the body. \n\nArteries generally have thick walls and a thin
    lumen. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
