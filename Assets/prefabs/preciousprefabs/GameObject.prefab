  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Valves are one way flap like structures that prevent the backflow of blood
    away from the heart. The Tunica Intima is interspersed with valves, in the extremities
    they help blood flow against gravity to return to the heart. \n\n"
  m_isRightToLeft: 0
